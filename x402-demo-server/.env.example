# x402 Resource Server Configuration
# Algorand TestNet - hosted GoPlausible facilitator

# Your resource server receiving address (for USDC payments)
# See: https://dev.algorand.co/concepts/accounts/create/
AVM_ADDRESS=

# Hosted Facilitator URL (use GoPlausible by default)
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Server port
PORT=4021

# Network Mode: testnet (default) or mainnet
NETWORK_MODE=testnet

# OpenRouter API Key (LEGACY — Groq is now the primary AI provider)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Groq AI Configuration (primary AI provider)
# Up to 3 Groq API keys for rotation and failover
# Get keys at: https://console.groq.com/keys
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Default Groq model (configurable)
GROQ_MODEL=openai/gpt-oss-20b

# MongoDB URI (Atlas or local) and Database Name
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=prism_app

# JWT secret keys for access and refresh tokens
JWT_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# GitHub Token (optional but strongly recommended for code review)
# Without this, GitHub API is limited to 60 requests/hour (unauthenticated).
# A personal access token raises the limit to 5,000 requests/hour.
# Generate at: https://github.com/settings/tokens (public_repo read scope is sufficient)
# GITHUB_TOKEN=ghp_your_token_here
